# Supabase local: valores impressos por `supabase status -o env` após `supabase start`.
# Supabase remoto (quando conectado): painel do projeto, região sa-east-1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. Nunca com prefixo NEXT_PUBLIC. Nunca em código que chegue ao browser.
# Uso permitido: scripts locais de seed/teste e lib/supabase/admin.ts (server-only).
SUPABASE_SERVICE_ROLE_KEY=

# Canal WhatsApp (decisao de 19/08/2026: uazapi com camada adaptadora).
# fake = dublê de desenvolvimento (conecta na hora, sem QR).
WHATSAPP_PROVIDER=fake
UAZAPI_SERVER_URL=
UAZAPI_ADMIN_TOKEN=

# Endereco publico do sistema, usado na URL do webhook. Em desenvolvimento
# com tunel (cloudflared), cole aqui a URL do tunel: o servidor do uazapi
# nao alcanca localhost.
PUBLIC_APP_URL=

# Transcricao de audio de paciente no download de midia (opcional).
# ATENCAO: preencher isto envia o audio para a OpenAI atraves do servidor
# uazapi. Deixe vazio para nao transcrever (padrao seguro).
UAZAPI_OPENAI_KEY=
